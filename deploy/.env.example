# Normally you do NOT write this by hand: run ./gen-secrets.sh, which creates .env with random secrets.
# This file only documents every variable. Never commit the real .env.
API_DOMAIN=api.example.com
POSTGRES_PASSWORD=change-me-long-random
JWT_SECRET=change-me-at-least-32-random-characters-long
# Encrypts every drawing at rest (AES-256-GCM). Generate:  openssl rand -base64 32
# BACK THIS UP somewhere other than the server and the database backups (e.g. a password manager).
# If it is lost, every stored drawing is permanently unreadable. Do not change it casually: to rotate,
# put the new key in DATA_KEY and move the previous one to DATA_KEY_OLD (comma-separated list).
DATA_KEY=change-me-run-openssl-rand-base64-32
DATA_KEY_OLD=
GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
# https://<your-extension-id>.chromiumapp.org/   (see README, "Google sign-in setup")
ALLOWED_REDIRECT_URIS=https://abcdefghijklmnopabcdefghijklmnop.chromiumapp.org/
# chrome-extension://<your-extension-id>
CORS_ORIGINS=chrome-extension://abcdefghijklmnopabcdefghijklmnop
# Public half of an age key pair (age-keygen on YOUR computer). Backups are encrypted to it; the private half never goes on the server.
BACKUP_AGE_RECIPIENT=age1replace-with-your-age-public-key
# Optional: invite emails when you share (free Brevo plan, 300/day). Leave empty to disable.
# MAIL_FROM must be a sender address you verified in Brevo. INSTALL_URL = Chrome Web Store link (once published).
BREVO_API_KEY=
MAIL_FROM=
INSTALL_URL=
