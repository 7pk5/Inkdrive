{
  "manifest_version": 3,
  "name": "Inkdrive",
  "description": "Save your excalidraw.com drawings to your own private cloud, with autosave, folders and tags.",
  "version": "0.1.1",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "identity", "sidePanel", "alarms"],
  "host_permissions": [],
  "background": { "service_worker": "background.js", "type": "module" },
  "side_panel": { "default_path": "sidepanel.html" },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": {
    "default_title": "Inkdrive",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://excalidraw.com/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://excalidraw.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
